# Copy locally to .env for reference; the server does not automatically load it.
# Set these in Render Environment; never commit real secrets.
NODE_ENV=production
PORT=10000
BASE_PATH=/
SITE_AT_ROOT=true
DATABASE_URL=
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Kenya Campaign Manager
# Leave blank for username/password sign-in without mandatory enrolment.
MFA_REQUIRED_ROLES=
# Root account for a new client: their email plus a temporary password (16+ characters).
# They must choose their own password at first sign-in and can change the email later.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional first campaign. Leave unset to configure through the app.
PRIMARY_SEAT=
PRIMARY_COUNTY=
PRIMARY_CONSTITUENCY=
PRIMARY_WARD=
PRIMARY_CANDIDATE=
PRIMARY_CAMPAIGN_NAME=
PRIMARY_ORGANISATION_NAME=

# Optional: YouTube video search in social listening (YouTube Data API v3 key).
# Each scan uses up to 200 of the free 10,000 daily quota units.
YOUTUBE_API_KEY=

# Optional demo: creates sign-ins demo.mca (Ukia Ward), demo.mp (Changamwe) and
# demo.governor (Kisumu County), each seeing only its own area. 16+ characters.
# Leave empty in production.
DEMO_ASPIRANTS_PASSWORD=

# Main contact email for the system. Demo requests from the website are emailed here.
SYSTEM_EMAIL=info@aclss.co.ke
# Brevo (brevo.com) API key used to send those emails over HTTPS. Leave empty to
# only store demo requests (System Health > Demo requests).
BREVO_API_KEY=
# Sender shown on notification emails; must be a verified sender in Brevo.
MAIL_FROM=info@aclss.co.ke
MAIL_FROM_NAME=Command Centre
# Optional: send demo requests to a different inbox than SYSTEM_EMAIL.
DEMO_NOTIFY_EMAIL=
